{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/install.js\"",
            "async": false
          }
        ],
        "description": "Install transpile binary if missing (cross-platform), seed PostToolUse hook"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/transpile-hook.sh\""
          }
        ]
      }
    ]
  }
}
