{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'script=\"${CLAUDE_PLUGIN_ROOT}/hooks/setup.sh\"; [ -f \"$script\" ] && bash \"$script\" || true'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/transpile-hook.sh\""
          }
        ]
      }
    ]
  }
}
